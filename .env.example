APPLICATION_NAME=payment-service
ENVIRONMENT=local
LOG_LEVEL=INFO

POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

API_KEY=local-dev-api-key
WEBHOOK_SIGNING_SECRET=local-dev-webhook-secret

RABBITMQ_DEFAULT_USER=payments
RABBITMQ_DEFAULT_PASS=payments
RABBITMQ_URL=amqp://payments:payments@localhost:5672/

OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_RETRY_BASE_SECONDS=5

GATEWAY_MIN_LATENCY_SECONDS=2.0
GATEWAY_MAX_LATENCY_SECONDS=5.0
GATEWAY_SUCCESS_RATE=0.9
GATEWAY_UNAVAILABLE_RATE=0.0

PROCESSING_MAX_ATTEMPTS=3
PROCESSING_RETRY_BASE_SECONDS=5
PROCESSING_RETRY_MULTIPLIER=3

WEBHOOK_TIMEOUT_SECONDS=5.0
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_BACKOFF_BASE_SECONDS=1.0
